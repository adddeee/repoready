<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>repoready</ToolCommandName>
    <PackageId>RepoReady.Tool</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Version>0.1.0</Version>
    <Authors>RepoReady contributors</Authors>
    <Description>Explainable readiness checks for public GitHub repositories.</Description>
    <IsPackable>true</IsPackable>
    <RepositoryUrl>https://github.com/adddeee/repoready</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\RepoReady.Core\RepoReady.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>
</Project>
